[Unit]
Description=Servidor web de control del robot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/robot-server
Restart=on-failure
RestartSec=2
Environment=ROBOT_SERVER_PORT=8080
Environment=ROBOT_SERVER_USER=admin
Environment=ROBOT_SERVER_PASSWORD=admin

[Install]
WantedBy=multi-user.target